{
  "name": "r2bp-msaas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:check-local": "tsx --env-file=.env scripts/db-check-local.ts",
    "db:prepare-local": "npm run db:deploy && npm run db:seed && npm run db:check-local",
    "db:setup-local": "npm run db:prepare-local",
    "supabase:start": "cd D:\\Supabase_Db\\supabase && npx supabase start",
    "supabase:stop": "cd D:\\Supabase_Db\\supabase && npx supabase stop",
    "supabase:status": "cd D:\\Supabase_Db\\supabase && npx supabase status",
    "dev:local": "npm run supabase:start && npm run db:setup-local && node -e \"console.log('\\n[dev:local] Ambiente pronto. Iniciando Next.js em http://localhost:3000\\n')\" && npm run dev",
    "cli": "tsx cli/index.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-slot": "^1.2.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.1",
    "lucide-react": "^0.511.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.29",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.3",
    "pino": "^9.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.7.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "typescript": "^5"
  }
}
