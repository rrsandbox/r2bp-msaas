@host = http://localhost:3000
@cookie = authjs.session-token={{SESSION_TOKEN}}
@userId = user-id
@featureId = feature-id
@permissionId = permission-id
@eventId = event-id
@commentId = comment-id
@tenantId = tenant-id

# Dica de setup local:
# 1) Rode npx supabase start
# 2) Rode npm run db:prepare-local
# 3) Login com admin@sistema.local / ChangeMe123!
# 4) Use os IDs impressos pelo seed para userId, featureId e eventId

### [0] Health check local
GET {{host}}/api/system/status

### [0.1] Setup check (DB + tabelas criticas)
GET {{host}}/api/system/setup

### [1] Access - listar features
GET {{host}}/api/access/features
Cookie: {{cookie}}

### [1.1] Users - listar usuarios (para obter userId)
GET {{host}}/api/users
Cookie: {{cookie}}

### [2] Access - criar feature
POST {{host}}/api/access/features
Content-Type: application/json
Cookie: {{cookie}}

{
  "key": "agenda:read",
  "name": "Agenda leitura",
  "description": "Permite consultar agenda",
  "route": "/agenda",
  "showInMenu": true,
  "showInDashboard": true,
  "sortOrder": 10,
  "enabled": true
}

### [3] Access - listar permissoes customizadas
GET {{host}}/api/access/permissions
Cookie: {{cookie}}

### [4] Access - criar/atualizar permissao por usuario
PUT {{host}}/api/access/permissions
Content-Type: application/json
Cookie: {{cookie}}

{
  "userId": "{{userId}}",
  "featureId": "{{featureId}}",
  "canAccess": true
}

### [5] Access - remover permissao customizada
DELETE {{host}}/api/access/permissions
Content-Type: application/json
Cookie: {{cookie}}

{
  "permissionId": "{{permissionId}}"
}

### [6] Agenda - listar com filtros, paginacao e ordenacao
GET {{host}}/api/agenda?startsFrom=2026-04-01&startsTo=2026-04-30&ownerQuery=admin&page=1&pageSize=10&startsAtSort=asc
Cookie: {{cookie}}

### [7] Agenda - criar evento
POST {{host}}/api/agenda
Content-Type: application/json
Cookie: {{cookie}}

{
  "title": "Reuniao de operacao",
  "description": "Revisao semanal",
  "startsAt": "2026-04-18T10:00:00.000Z",
  "endsAt": "2026-04-18T11:00:00.000Z"
}

### [8] Agenda - atualizar evento
PATCH {{host}}/api/agenda/{{eventId}}
Content-Type: application/json
Cookie: {{cookie}}

{
  "title": "Reuniao atualizada",
  "description": "Revisao semanal atualizada",
  "startsAt": "2026-04-18T10:30:00.000Z",
  "endsAt": "2026-04-18T11:30:00.000Z"
}

### [9] Agenda - remover evento
DELETE {{host}}/api/agenda/{{eventId}}
Cookie: {{cookie}}

### [10] Comentarios landing - listar (tenant autenticado)
GET {{host}}/api/tenants/comments?limit=5
Cookie: {{cookie}}

### [11] Comentarios landing - criar
POST {{host}}/api/tenants/comments
Content-Type: application/json
Cookie: {{cookie}}

{
  "comment": "Comentario publicado via api.http para validar fluxo completo"
}

### [12] Comentarios landing - atualizar
PUT {{host}}/api/tenants/comments
Content-Type: application/json
Cookie: {{cookie}}

{
  "commentId": "{{commentId}}",
  "comment": "Comentario atualizado via api.http"
}

### [13] Comentarios landing - excluir
DELETE {{host}}/api/tenants/comments
Content-Type: application/json
Cookie: {{cookie}}

{
  "commentId": "{{commentId}}"
}

### [14] Tenants - listar
GET {{host}}/api/tenants
Cookie: {{cookie}}

### [15] Tenants - criar PF
POST {{host}}/api/tenants
Content-Type: application/json
Cookie: {{cookie}}

{
  "name": "Cliente PF API",
  "slug": "cliente-pf-api",
  "legalProfile": {
    "personType": "PF",
    "qualification": {
      "fullName": "Cliente PF API",
      "document": {
        "type": "CPF",
        "number": "12345678901"
      },
      "birthDate": "1992-08-14",
      "email": "cliente.pf.api@example.com",
      "phone": "11991112222",
      "occupation": "Consultor"
    }
  },
  "billingProfile": {
    "contactEmail": "cliente.pf.api@example.com",
    "contactPhone": "11991112222",
    "personType": "PF"
  },
  "adminProfile": {
    "personType": "PF",
    "fullName": "Cliente PF API",
    "email": "cliente.pf.api@example.com"
  }
}

### [16] Tenants - atualizar para PJ com representante
PATCH {{host}}/api/tenants/{{tenantId}}
Content-Type: application/json
Cookie: {{cookie}}

{
  "name": "Cliente PJ API",
  "status": "active",
  "legalProfile": {
    "personType": "PJ",
    "qualification": {
      "corporateName": "Cliente PJ API LTDA",
      "tradeName": "Cliente PJ",
      "document": {
        "type": "CNPJ",
        "number": "12345678000199"
      },
      "email": "contato@clientepjapi.com",
      "phone": "1133334444",
      "mainActivity": "Servicos B2B"
    },
    "legalRepresentative": {
      "fullName": "Representante API",
      "document": {
        "type": "CPF",
        "number": "98765432100"
      },
      "birthDate": "1985-03-22",
      "email": "representante@clientepjapi.com",
      "phone": "11994445555",
      "occupation": "Administrador"
    }
  },
  "billingProfile": {
    "contactEmail": "contato@clientepjapi.com",
    "contactPhone": "1133334444",
    "personType": "PJ"
  },
  "adminProfile": {
    "personType": "PF",
    "fullName": "Representante API",
    "email": "representante@clientepjapi.com"
  }
}

### [17] Tenants - remover
DELETE {{host}}/api/tenants/{{tenantId}}
Cookie: {{cookie}}

### [18] Auditoria - listar logs do tenant autenticado
GET {{host}}/api/audit/logs?page=1&pageSize=20
Cookie: {{cookie}}

### [19] Auditoria - filtrar warnings de acesso negado no periodo
GET {{host}}/api/audit/logs?page=1&pageSize=20&severity=WARNING&action=ACCESS_DENIED&from=2026-04-01T00:00:00.000Z&to=2026-04-30T23:59:59.000Z
Cookie: {{cookie}}

### [20] Auditoria - exportar CSV
GET {{host}}/api/audit/logs/export?severity=WARNING&action=ACCESS_DENIED&maxRows=2000
Cookie: {{cookie}}

### [21] Auditoria - executar retencao (dry-run)
POST {{host}}/api/system/audit/retention
Content-Type: application/json
Cookie: {{cookie}}

{
  "retentionDays": 180,
  "dryRun": true
}

# Uso:
# 1) Preencha SESSION_TOKEN
# 2) Opcional: ajuste host
# 3) Atualize userId/featureId/permissionId/eventId/commentId/tenantId conforme seu ambiente
# 4) Execute em ordem para smoke test manual
